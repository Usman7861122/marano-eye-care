---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
interface Props { title: string; eyebrow?: string; lede?: string; description?: string; image?: string; imageAlt?: string; position?: string; noindex?: boolean }
const p = Astro.props;
const image = p.image ?? '/images/stock/shutterstock_591166769.jpg';
const imageAlt = p.imageAlt ?? 'Marano Eye Care';
---
<BaseLayout title={p.title} description={p.description} noindex={p.noindex}>
  <PageHero {...p} image={image} imageAlt={imageAlt} />
  <slot />
</BaseLayout>
