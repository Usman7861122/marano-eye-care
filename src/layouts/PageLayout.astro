---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
interface Props { title: string; eyebrow?: string; lede?: string; description?: string; image?: string; imageAlt?: string; position?: string; noindex?: boolean }
const p = Astro.props;
---
<BaseLayout title={p.title} description={p.description} noindex={p.noindex}>
  <PageHero {...p} />
  <slot />
</BaseLayout>
