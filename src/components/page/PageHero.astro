---
// Dark title band used on inner pages (same idea as the Chu Vision inner pages)
interface Props { title: string; lede?: string; image: string; imageAlt: string; crumbs?: { label: string; href?: string }[]; portrait?: boolean; position?: string }
const { title, lede, image, imageAlt, crumbs = [], portrait = false, position = 'object-center' } = Astro.props;
---
<section
  class="relative overflow-hidden bg-navy pb-[clamp(48px,6vw,96px)] pt-[clamp(130px,12vw,190px)] text-white"
  style="background-image: radial-gradient(circle at 10% 110%, rgba(122,149,204,.45) 0%, rgba(0,0,0,0) 45%), linear-gradient(180deg, #1a2748 0%, #121a33 100%);"
>
  <div class="row-wrap grid items-center gap-10 md:grid-cols-2 md:gap-[clamp(32px,6vw,96px)]">
    <div>
      <nav aria-label="Breadcrumb" class="mb-5 text-[14px] text-white/80">
        <a href="/" class="hover:underline">Home</a>
        {crumbs.map((c) => (<><span class="mx-2" aria-hidden="true">/</span>{c.href ? <a href={c.href} class="hover:underline">{c.label}</a> : <span aria-current="page">{c.label}</span>}</>))}
      </nav>
      <h1 class="serif text-[length:var(--fs-h1)] leading-[1.1]">{title}</h1>
      {lede && <p class="mt-6 max-w-[520px] text-[clamp(17px,1.5vw,20px)] leading-[1.6] text-white/90">{lede}</p>}
    </div>
    <div class={`relative overflow-hidden rounded-[16px] shadow-[0_30px_60px_-30px_rgba(0,0,0,.6)] ${portrait ? "ml-auto aspect-[4/5] w-full max-w-[400px] max-md:mx-auto" : "aspect-[4/3]"}`}>
      <img src={image} alt={imageAlt} class={`absolute inset-0 h-full w-full object-cover ${position}`} />
    </div>
  </div>
</section>
