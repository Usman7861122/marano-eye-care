---
import QuoteCarousel from './QuoteCarousel.tsx';
import { home } from '../../data/home';
import { reviews, rating } from '../../data/reviews';
const pick = ['Richard C.', 'Terry Z.', 'Susan C.', 'Rosemary L.', 'Evelyn S.', 'John W.'];
const shown = pick.map((n) => reviews.find((r) => r.name === n)!);
---
<section
  id="testimonials"
  class="relative grid bg-navy text-white"
  style="background-image: none;"
>
  <!-- Pinned gradient background -->
  <div
    class="pointer-events-none sticky top-0 col-start-1 row-start-1 h-screen self-start"
    style="background-image: radial-gradient(circle at 10% 100%, #7a95cc 0%, rgba(0,0,0,0) 30%), radial-gradient(circle at 100% 80%, #7a95cc 0%, rgba(0,0,0,0) 50%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative col-start-1 row-start-1">
    <!-- Rolling quotes -->
    <div class="relative pb-[clamp(100px,calc(68.45px+8.4142vw),230px)] pt-[clamp(170px,calc(129.47px+10.8091vw),337px)]">
      <div class="quote-mark" aria-hidden="true"></div>
      <QuoteCarousel client:visible quotes={home.quotes} />
    </div>

    <!-- Google reviews -->
    <div class="mx-auto w-screen max-w-[calc(60px+clamp(1200px,83.3333vw,1600px))] px-[30px] pb-[clamp(60px,calc(32.9px+7.4434vw),175px)]">
      <div class="mb-[clamp(30px,calc(25.15px+1.2945vw),50px)] flex flex-wrap items-end justify-between gap-6">
        <h2 class="serif text-[length:var(--fs-h1)] leading-[1.2]">
          <span class="eyebrow">Google Reviews</span>
          Words From <i>Our Patients</i>
        </h2>
        <div class="flex items-center gap-4 rounded-[16px] bg-white/10 px-5 py-4" aria-label={`Rated ${rating.score} out of 5 from ${rating.count} reviews`}>
          <span class="serif text-[44px] leading-none">{rating.score}</span>
          <div>
            <div class="text-[18px] leading-none tracking-[2px] text-[#f5b942]" aria-hidden="true">★★★★★</div>
            <p class="mt-1 text-[14px] opacity-85">{rating.count} Google reviews</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 min-[801px]:grid-cols-2 min-[1025px]:grid-cols-3">
        {shown.map((r) => (
          <figure class="flex flex-col rounded-[16px] bg-white p-7 text-black">
            <div class="text-[18px] leading-none tracking-[2px] text-[#f5b942]" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote class="mt-4 flex-1 text-[17px] leading-[1.6]">“{r.text}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-navy text-[15px] font-semibold text-white" aria-hidden="true">{r.name[0]}</span>
              <span>
                <span class="block font-semibold leading-tight">{r.name}</span>
                <span class="block text-[14px] text-slate">{r.tag}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/testimonials" class="btn white">Read More Reviews</a>
      </div>
    </div>
  </div>
</section>
