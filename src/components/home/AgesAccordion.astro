---
import HoverAccordion from './HoverAccordion.tsx';
import { home } from '../../data/home';
import { img, vid } from '../../data/assets';

const slides = [
  ...home.ages.map((a, i) => ({
    image: img.ages[i],
    titleA: a.h,
    text: a.p,
    cta: { label: a.cta, href: a.href },
  })),
  {
    video: vid.ageVideo,
    titleA: '',
    watchUrl: home.ageVideo.url,
    watchLabel: home.ageVideo.watch,
    text: home.ageVideo.p,
    cta: { label: home.ageVideo.cta, href: home.ageVideo.href },
  },
];
---
<section id="ages" class="bg-navy py-[clamp(64px,7.8vw,112px)] text-white">
  <h2 class="serif row-wrap text-center text-[length:var(--fs-h2)] leading-[1.2]">
    <span class="eyebrow !mt-0">From 18 to 80+</span>
    Good Sight <i>at Every Age</i>
  </h2>
  <div class="row-wrap my-10">
    <HoverAccordion client:visible variant="ages" slides={slides} />
  </div>
</section>
