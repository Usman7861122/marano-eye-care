---
import { home } from '../../data/home';
import { img } from '../../data/assets';
---
<section class="round-top bg-mist pb-[37.6px] pt-[101px] text-white">
  <h2 class="row-wrap mb-[37px] text-center text-[20px] font-semibold leading-[24px] text-navy">
    Welcome to Marano Eye Care: Trusted Eye Doctors in New Jersey
  </h2>

  <div class="row-wrap grid gap-5 md:grid-cols-2">
    {home.banners.map((b, i) => (
      <div class="group hover-card relative flex min-h-[380px] flex-col justify-end overflow-hidden rounded-[16px] border border-transparent bg-card md:h-[465px]">
        <img src={b.image} alt={b.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none" />
        <div class="absolute inset-0 bg-gradient-to-t from-navy/70 via-transparent to-transparent transition-opacity duration-300 group-hover:from-navy/85"></div>
        <div class="relative mx-[25px] px-[30px] pb-[30px]">
          <h2 class="serif text-[length:var(--fs-h2b)] leading-[1.2]">
            <span class="eyebrow">{b.label}</span>
            {b.title}
          </h2>
          <p class="mt-[13px] translate-y-2 group-hover:translate-y-0 max-md:translate-y-0 leading-[1.6] opacity-0 transition duration-300 group-hover:opacity-100 max-md:opacity-100">{b.text}</p>
        </div>
        <a href={b.url} class="absolute inset-0" aria-label={b.title}></a>
      </div>
    ))}
  </div>

  <div class="row-wrap mt-[73px] flex flex-wrap items-center justify-center gap-x-[53px] gap-y-6">
    {img.credentials.map((src) => (
      <img src={src} alt="" loading="lazy" class="h-[78px] w-[97px] object-contain" />
    ))}
  </div>
</section>
