---
import { img } from '../../data/assets';
---
<section class="bg-navy py-[clamp(48px,calc(16px+3.3333vw),80px)] text-white">
  <div class="row-wrap my-10 flex flex-col-reverse items-center min-[1025px]:flex-row-reverse">
    <div class="relative aspect-square w-full overflow-hidden [clip-path:circle()] min-[1025px]:w-1/2">
      <img src={img.team} alt="The Chu Vision Institute team" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
    </div>
    <div class="flex w-full flex-col justify-center py-[60px] min-[1025px]:w-1/2">
      <div class="ml-auto max-w-[670px] py-[15px] min-[1025px]:pr-[clamp(80px,calc(64.53px+4.1424vw),144px)]">
        <h2 class="serif text-[length:var(--fs-h1)] leading-[1.2]">
          <span class="eyebrow">Humans Serving Humans</span>
          Meet Our <i class="block">Dedicated Team</i>
        </h2>
        <p class="leading-[1.6]">We're obsessed with you and your vision.</p>
        <p class="mt-[clamp(20px,calc(15.15px+1.2945vw),40px)] flex gap-[clamp(15px,calc(11.36px+.9709vw),30px)]">
          <a href="/about-us/our-team/" class="btn white">Get To Know Us</a>
        </p>
      </div>
    </div>
  </div>
</section>
