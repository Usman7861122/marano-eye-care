---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import CtaSub from '../../components/home/CtaSub.astro';
import { doctors } from '../../data/doctors';
import { site } from '../../data/site';

export function getStaticPaths() {
  return doctors.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const others = doctors.filter((x) => x.slug !== d.slug);
---
<BaseLayout title={`${d.name} | Marano Eye Care`} description={d.description}>
  <PageHero title={d.name} lede={d.role} image={d.image} imageAlt={d.name} portrait position={d.position} crumbs={[{ label: 'About Us', href: '/about' }, { label: 'Our Doctors', href: '/provider' }, { label: d.short }]} />

  <section class="bg-white py-[clamp(56px,8vw,120px)]">
    <div class="row-wrap grid items-start gap-12 lg:grid-cols-[7fr_4fr] lg:gap-[clamp(40px,6vw,96px)]">
      <div>
        <h2 class="serif text-[length:var(--fs-h2)] leading-[1.15] text-navy">Meet <i>{d.short}</i></h2>
        <p class="mt-6 text-[20px] leading-[1.6] text-navy">{d.intro}</p>
        {d.bio.map((p) => <p class="mt-5 text-[18px] leading-[1.75]">{p}</p>)}
        {d.interests && (
          <div class="hover-card mt-10 rounded-[16px] border border-transparent bg-card p-7">
            <h3 class="serif text-[24px] text-navy">Away from the office</h3>
            <p class="mt-3 text-[17px] leading-[1.7]">{d.interests}</p>
          </div>
        )}
      </div>

      <aside class="lg:sticky lg:top-32">
        <div class="overflow-hidden rounded-[16px] bg-navy p-8 text-white">
          <h3 class="serif text-[26px] leading-tight">At a glance</h3>
          <ul class="mt-5 space-y-3">
            {d.highlights.map((h) => (
              <li class="flex gap-3 text-[16px] leading-snug">
                <svg class="mt-[3px] shrink-0 text-sky" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                {h}
              </li>
            ))}
          </ul>
          <p class="mt-8 flex flex-wrap gap-3">
            <a href={site.bookingUrl} class="btn white">Book an Appointment</a>
            <a href={site.phoneHref} class="btn !bg-transparent !text-white !border-white/60">{site.phone}</a>
          </p>
        </div>
        <div class="hover-card on-white mt-6 rounded-[16px] border border-navy/15 p-7">
          <h3 class="serif text-[22px] text-navy">Where to see {d.short}</h3>
          <ul class="mt-3 space-y-1 text-[17px]">
            <li><a class="hover:underline" href="/location/nj/denville">Denville, NJ</a></li>
            <li><a class="hover:underline" href="/location/nj/livingston">Livingston, NJ</a></li>
            <li><a class="hover:underline" href="/location/nj/newark">Newark, NJ</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-card py-[clamp(48px,6vw,96px)]">
    <div class="row-wrap">
      <h2 class="serif text-center text-[length:var(--fs-h2b)] leading-[1.15] text-navy">Meet our other <i>doctors</i></h2>
      <ul class="mx-auto mt-10 grid max-w-[820px] gap-6 sm:grid-cols-2">
        {others.map((o) => (
          <li>
            <a href={`/provider/${o.slug}`} class="flex items-center gap-5 rounded-[16px] bg-white p-4 transition hover:shadow-[0_18px_30px_-20px_rgba(26,39,72,.5)]">
              <img src={o.image} alt={o.name} loading="lazy" class="h-24 w-24 shrink-0 rounded-full object-cover object-top" />
              <span>
                <span class="serif block text-[22px] leading-tight text-navy">{o.name}</span>
                <span class="mt-1 block text-[13px] uppercase tracking-[0.1em] text-steel">{o.role}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaSub />
</BaseLayout>
