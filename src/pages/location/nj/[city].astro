---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/page/PageHero.astro';
import CtaSub from '../../../components/home/CtaSub.astro';
import { site } from '../../../data/site';
import { services } from '../../../data/svc';
import { doctors } from '../../../data/doctors';

export function getStaticPaths() {
  return ['Denville', 'Livingston', 'Newark'].map((city) => ({ params: { city: city.toLowerCase() }, props: { city } }));
}
const { city } = Astro.props;
const loc = site.locations.find((l) => l.city === city)!;
const towns: Record<string, string[]> = {
  Denville: ['Denville', 'Rockaway', 'Boonton', 'Mountain Lakes', 'Parsippany', 'Dover', 'Randolph', 'Morristown'],
  Livingston: ['Livingston', 'West Orange', 'Millburn', 'Short Hills', 'Roseland', 'Florham Park', 'Verona', 'Caldwell', 'Montclair'],
  Newark: ['Newark', 'Belleville', 'Bloomfield', 'East Orange', 'Irvington', 'Harrison', 'Kearny', 'Elizabeth', 'Jersey City'],
};
const county: Record<string, string> = { Denville: 'Morris County', Livingston: 'Essex County', Newark: 'Essex and Union County' };
// [open, close] in 24h, null = closed. Index 0 = Sunday.
const hoursBy: Record<string, ([number, number] | null)[]> = {
  Denville: [null, [9, 17], [9, 17], [9, 17], [9, 17], [8, 16], null],
  Livingston: [null, [9, 17], [8, 17], [12, 20], [9, 17], [8, 16], null],
  Newark: [null, [9, 17], [9, 17], [9, 17], [9, 17], [9, 17], null],
};
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const t12 = (h: number) => `${((h + 11) % 12) + 1}:00 ${h >= 12 ? 'pm' : 'am'}`;
const rows = [1, 2, 3, 4, 5, 6, 0].map((d) => ({ d, name: dayNames[d], h: hoursBy[city][d], text: hoursBy[city][d] ? `${t12(hoursBy[city][d]![0])} - ${t12(hoursBy[city][d]![1])}` : 'Closed' }));
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(loc.address.join(' '))}`;
const featured = ['cataract-surgery', 'lasik', 'glaucoma', 'dry-eyes', 'comprehensive-eye-exam', 'macular-degeneration']
  .map((slug) => (slug === 'cataract-surgery' ? { slug, title: 'Cataract Surgery', short: 'Laser-assisted surgery for clear, bright sight.', img: '/images/stock/shutterstock_2767408177.jpg' } : (() => { const s = services.find((x) => x.slug === slug)!; return { slug, title: s.title, short: s.short, img: s.photos[0] }; })()));
---
<BaseLayout title={`Eye Doctor in ${city}, NJ | Marano Eye Care`} description={`Marano Eye Care in ${city}, NJ, ${loc.address[0]}. Eye exams, cataract surgery, LASIK, glaucoma and more. Call ${loc.phone}.`}>
  <PageHero
    title="Eye Care in"
    accent={`${city}, NJ`}
    lede={`Our ${city} office offers complete eye exams and advanced eye surgery, close to home.`}
    image={featured[4].img}
    imageAlt={`An eye doctor examines a patient at our ${city} office`}
    areas={`Our ${city} office welcomes patients from ${towns[city].join(', ')} and the wider ${county[city]} area.`}
    crumbs={[{ label: 'Locations' }, { label: `${city}, NJ` }]}
  />
  <section class="bg-white py-[clamp(48px,7vw,110px)]">
    <div class="row-wrap grid items-start gap-10 md:grid-cols-[5fr_7fr] md:gap-[clamp(32px,6vw,96px)]">
      <div>
      <div class="hover-card rounded-[16px] border border-transparent bg-card p-8">
        <span class="eyebrow">Our {city} office</span>
        <address class="serif mt-3 text-[26px] not-italic leading-tight text-navy">{loc.address.map((a) => <span class="block">{a}</span>)}</address>
        <p class="mt-4 text-[20px]"><a href={loc.phoneHref} class="font-semibold text-navy hover:underline">{loc.phone}</a></p>
        <p class="mt-8 flex flex-wrap gap-3">
          <a href={loc.phoneHref} class="btn">Call Now</a>
          <a href={maps} target="_blank" rel="noopener noreferrer" class="btn white !text-navy !border-navy">Get Directions</a>
        </p>
        </div>
        <div class="mt-6 rounded-[16px] border border-transparent bg-mist p-8" id="hours" data-hours={JSON.stringify(hoursBy[city])}>
          <span class="eyebrow">Office hours</span>
          <p id="open-now" class="serif mt-1 text-[22px] text-navy" aria-live="polite">&nbsp;</p>
          <table class="mt-4 w-full text-[17px]">
            <tbody>
              {rows.map((r) => (
                <tr data-day={r.d} class="border-b border-navy/10 last:border-0">
                  <th scope="row" class="py-2.5 pr-4 text-left font-medium text-navy">{r.name}<span class="today-tag ml-2 hidden rounded-full bg-navy px-2 py-0.5 text-[12px] font-normal text-white">Today</span></th>
                  <td class="py-2.5 text-right">{r.text}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-4 text-[15px]">Medical emergency? Call <a class="font-semibold text-navy underline" href="tel:+19733220100">973-322-0100</a>. Times are Eastern Time.</p>
        </div>
      </div>
      <div>
        <span class="eyebrow">Nearby areas</span>
        <h2 class="serif text-[length:var(--fs-h2)] leading-[1.15] text-navy">Who we serve <i class="block">near {city}</i></h2>
        <p class="mt-5 text-[18px] leading-[1.7]">Patients visit our {city} office from all over {county[city]}. If you live in one of these towns, we are a short drive away.</p>
        <ul class="mt-6 flex flex-wrap gap-3">
          {towns[city].map((t) => <li class="rounded-full border border-navy/30 bg-mist px-4 py-2 text-[16px] text-navy">{t}</li>)}
        </ul>
      </div>
    </div>
  </section>
  <section class="bg-white pb-[clamp(48px,7vw,110px)]">
    <div class="row-wrap">
      <div class="mx-auto max-w-[760px] text-center">
        <span class="eyebrow">Our doctors</span>
        <h2 class="serif text-[length:var(--fs-h2)] leading-[1.15] text-navy">Doctors available <i class="block">in {city}</i></h2>
        <p class="mt-5 text-[18px] leading-[1.7]">Our eye doctors see patients at the {city} office. Call {loc.phone} to book with the doctor you prefer.</p>
      </div>
      <ul class="mt-12 grid gap-8 md:grid-cols-3">
        {doctors.map((d) => (
          <li>
            <a href={`/provider/${d.slug}`} class="hover-card group block overflow-hidden rounded-[16px] border border-transparent bg-card">
              <div class="relative aspect-[4/5] overflow-hidden bg-mist">
                <img src={d.image} alt={d.name} loading="lazy" class={`absolute inset-0 h-full w-full object-cover ${d.position} transition duration-500 group-hover:scale-[1.03]`} />
              </div>
              <div class="p-7">
                <h3 class="serif text-[26px] leading-tight text-navy">{d.name}</h3>
                <p class="mt-2 text-[13px] font-semibold uppercase tracking-[0.12em] text-steel">{d.role}</p>
                <span class="mt-5 inline-block text-[15px] font-semibold text-steel">View Profile →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-center"><a href={loc.phoneHref} class="btn">Call {loc.phone}</a></p>
    </div>
  </section>
  <section class="bg-mist py-[clamp(48px,7vw,110px)]">
    <div class="row-wrap">
      <div class="mx-auto max-w-[760px] text-center">
        <span class="eyebrow">Services</span>
        <h2 class="serif text-[length:var(--fs-h2)] leading-[1.15] text-navy">Care you can get <i class="block">in {city}</i></h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((s) => (
          <a href={s.slug === 'cataract-surgery' || s.slug === 'comprehensive-eye-exam' ? `/services/${s.slug}/${city.toLowerCase()}-nj` : `/services/${s.slug}/${city.toLowerCase()}-nj`} class="hover-card on-white group flex flex-col overflow-hidden rounded-[16px] border border-transparent bg-white">
            <div class="relative aspect-[16/10] overflow-hidden"><img src={s.img} alt={s.title} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" /></div>
            <div class="p-6"><h3 class="serif text-[24px] text-navy">{s.title} in {city}</h3><p class="mt-2 text-[16px]">{s.short}</p></div>
          </a>
        ))}
      </div>
      <p class="mt-10 text-center"><a href="/services" class="btn">All services</a></p>
    </div>
  </section>
  <CtaSub />
</BaseLayout>
<script>
  const box = document.getElementById('hours');
  if (box) {
    const hours = JSON.parse(box.dataset.hours || '[]') as ([number, number] | null)[];
    const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/New_York' }));
    const day = now.getDay();
    const mins = now.getHours() * 60 + now.getMinutes();
    const fmt = (h: number) => `${((h + 11) % 12) + 1}:00 ${h >= 12 ? 'pm' : 'am'}`;
    const row = box.querySelector(`tr[data-day="${day}"]`);
    row?.classList.add('bg-white', 'font-semibold');
    row?.querySelector('.today-tag')?.classList.remove('hidden');
    const out = document.getElementById('open-now');
    const today = hours[day];
    let msg = '';
    if (today && mins >= today[0] * 60 && mins < today[1] * 60) msg = `Open now, until ${fmt(today[1])}`;
    else if (today && mins < today[0] * 60) msg = `Closed now, opens today at ${fmt(today[0])}`;
    else {
      for (let i = 1; i <= 7; i++) {
        const h = hours[(day + i) % 7];
        if (h) { msg = `Closed now, opens ${i === 1 ? 'tomorrow' : ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][(day + i) % 7]} at ${fmt(h[0])}`; break; }
      }
    }
    if (out) out.textContent = msg;
  }
</script>
