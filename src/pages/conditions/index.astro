---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import CtaSub from '../../components/home/CtaSub.astro';
import { site } from '../../data/site';
import { conditions } from '../../data/cond';
---
<BaseLayout title="Eye Conditions We Treat | Marano Eye Care" description="Learn about eye conditions treated at Marano Eye Care in Denville, Livingston and Newark, NJ: cataracts, glaucoma, dry eye, macular degeneration and more.">
  <PageHero
    title="Eye Conditions We Treat"
    lede="Learn the causes, signs and treatments for common eye problems, and find care close to home."
    image={conditions[1].photos[0]}
    imageAlt="An eye doctor examines a patient"
    areas={site.areasAll}
    crumbs={[{ label: 'Eye Conditions' }]}
  />
  <section class="bg-white py-[clamp(48px,7vw,110px)]">
    <div class="row-wrap">
      <div class="mx-auto max-w-[760px] text-center">
        <span class="eyebrow">All conditions</span>
        <h2 class="serif text-[length:var(--fs-h2)] leading-[1.15] text-navy">Understand <i class="block">your eye health</i></h2>
        <p class="mt-5 text-[18px] leading-[1.7]">Choose a condition to read more, or call us if you have symptoms.</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {conditions.map((s) => (
          <a href={`/conditions/${s.slug}`} class="hover-card group relative flex flex-col overflow-hidden rounded-[16px] border border-transparent bg-card">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img src={s.photos[0]} alt={s.title} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="serif text-[24px] leading-tight text-navy">{s.title}</h3>
              <p class="mt-3 text-[16px] leading-[1.6]">{s.short}</p>
              <span class="mt-auto pt-5 text-[15px] font-semibold text-steel">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-12 text-center"><a href={site.bookingUrl} class="btn">Book a Visit</a></p>
    </div>
  </section>
  <CtaSub />
</BaseLayout>
