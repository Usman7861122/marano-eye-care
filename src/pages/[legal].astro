---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import CtaSub from '../components/home/CtaSub.astro';
import { legal, UPDATED } from '../data/legal/pages';
import { site } from '../data/site';
export function getStaticPaths() {
  return legal.map((doc) => ({ params: { legal: doc.slug }, props: { doc } }));
}
const { doc } = Astro.props;
const others = legal.filter((d) => d.slug !== doc.slug);
---
<BaseLayout title={`${doc.title} | Marano Eye Care`} description={doc.desc}>
  <PageHero title={doc.title} lede={`Last updated ${UPDATED}`} image="/images/stock/shutterstock_591166769.jpg" imageAlt="Marano Eye Care" crumbs={[{ label: 'Legal' }, { label: doc.title }]} />
  <section class="bg-white py-[clamp(40px,6vw,100px)]">
    <div class="row-wrap grid items-start gap-10 lg:grid-cols-[3fr_8fr] lg:gap-[clamp(32px,5vw,80px)]">
      <aside class="lg:sticky lg:top-[140px]">
        <p class="eyebrow">On this page</p>
        <ul class="mt-3 grid gap-2 text-[16px]">
          {doc.sections.map((s, i) => <li><a href={`#s${i + 1}`} class="text-steel hover:underline">{s.h}</a></li>)}
        </ul>
        <p class="eyebrow mt-8">Other policies</p>
        <ul class="mt-3 grid gap-2 text-[16px]">
          {others.map((d) => <li><a href={`/${d.slug}`} class="text-steel hover:underline">{d.title}</a></li>)}
          <li><button type="button" data-cookie-settings class="text-steel hover:underline">Cookie Settings</button></li>
        </ul>
      </aside>
      <article class="max-w-[780px]">
        <p class="text-[19px] leading-[1.7]">{doc.intro}</p>
        {doc.sections.map((s, i) => (
          <section id={`s${i + 1}`} class="scroll-mt-[130px]">
            <h2 class="serif mt-10 text-[clamp(24px,2.6vw,32px)] leading-[1.2] text-navy">{s.h}</h2>
            {s.p?.map((t) => <p class="mt-3 text-[17px] leading-[1.75]">{t}</p>)}
            {s.ul && <ul class="mt-3 grid list-disc gap-2 pl-6 text-[17px] leading-[1.7]">{s.ul.map((t) => <li>{t}</li>)}</ul>}
          </section>
        ))}
        {doc.slug === 'notice-of-privacy-practices' && (
          <p class="mt-8 text-[17px]"><a class="underline text-steel" href="https://sa1s3optim.patientpop.com/assets/docs/425417.pdf" target="_blank" rel="noopener noreferrer">View the full printed notice (PDF)</a></p>
        )}
        <div class="mt-12 rounded-[16px] bg-mist p-7">
          <p class="text-[17px]">Questions? Call <a class="font-semibold text-navy underline" href={site.phoneHref}>{site.phone}</a> or <a class="font-semibold text-navy underline" href={site.bookingUrl}>request an appointment</a>.</p>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
