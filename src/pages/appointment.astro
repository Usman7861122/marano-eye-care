---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import { site } from '../data/site';
import { services } from '../data/svc';

const reasons = [
  { v: 'comprehensive-eye-exam', t: 'Comprehensive Eye Exam' },
  { v: 'cataract-surgery', t: 'Cataract Surgery' },
  ...services.filter((s) => s.slug !== 'comprehensive-eye-exam').map((s) => ({ v: s.slug, t: s.title })),
  { v: 'not-sure', t: 'I am not sure' },
];
const hours = { Denville: 'Mon to Thu 9-5, Fri 8-4', Livingston: 'Mon 9-5, Tue 8-5, Wed 12-8, Thu 9-5, Fri 8-4', Newark: 'Mon to Fri 9-5' } as Record<string, string>;
const field = 'mt-2 w-full rounded-[12px] border border-navy/25 bg-white px-4 py-3 text-[17px] text-navy outline-none transition focus:border-steel focus:ring-2 focus:ring-sky/50';
---
<BaseLayout title="Request an Appointment | Marano Eye Care" description="Request an eye appointment at Marano Eye Care in Denville, Livingston or Newark, NJ. Fill out the short form and our team will call you to confirm.">
  <PageHero
    title="Request an Appointment"
    lede="Tell us a little about your visit. Our team will call you to confirm a time that works for you."
    image={services.find((s) => s.slug === 'comprehensive-eye-exam')!.photos[1]}
    imageAlt="A patient at an eye exam"
    areas={site.areasAll}
    crumbs={[{ label: 'Appointment' }]}
  />
  <section class="bg-white py-[clamp(48px,7vw,110px)]">
    <div class="row-wrap grid items-start gap-10 lg:grid-cols-[7fr_5fr] lg:gap-[clamp(32px,5vw,80px)]">
      <form id="appt" novalidate class="rounded-[16px] bg-card p-6 sm:p-10" data-endpoint={site.formEndpoint}>
        <h2 class="serif text-[length:var(--fs-h2b)] leading-[1.15] text-navy">Your details</h2>
        <p class="mt-2 text-[16px]">Fields marked * are required.</p>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <label class="block text-[16px] font-semibold text-navy">Full name *<input name="name" required autocomplete="name" class={field} /></label>
          <label class="block text-[16px] font-semibold text-navy">Phone *<input name="phone" type="tel" required autocomplete="tel" inputmode="tel" class={field} /></label>
          <label class="block text-[16px] font-semibold text-navy sm:col-span-2">Email *<input name="email" type="email" required autocomplete="email" class={field} /></label>
          <label class="block text-[16px] font-semibold text-navy">Preferred office *
            <select name="office" required class={field}>
              <option value="">Choose an office</option>
              {site.locations.map((l) => <option value={l.city}>{l.city}, NJ</option>)}
            </select>
          </label>
          <label class="block text-[16px] font-semibold text-navy">Reason for visit *
            <select name="service" required class={field}>
              <option value="">Choose a service</option>
              {reasons.map((r) => <option value={r.v}>{r.t}</option>)}
            </select>
          </label>
          <label class="block text-[16px] font-semibold text-navy">Preferred date<input name="date" type="date" class={field} /></label>
          <label class="block text-[16px] font-semibold text-navy">Preferred time
            <select name="time" class={field}>
              <option value="Any time">Any time</option><option>Morning</option><option>Afternoon</option><option>Evening (Livingston, Wednesday)</option>
            </select>
          </label>
          <fieldset class="sm:col-span-2">
            <legend class="text-[16px] font-semibold text-navy">Are you a patient with us already?</legend>
            <div class="mt-2 flex flex-wrap gap-6 text-[17px]">
              <label class="flex items-center gap-2"><input type="radio" name="patient" value="New patient" checked class="accent-[#2f4373]" /> New patient</label>
              <label class="flex items-center gap-2"><input type="radio" name="patient" value="Existing patient" class="accent-[#2f4373]" /> Existing patient</label>
            </div>
          </fieldset>
          <label class="block text-[16px] font-semibold text-navy sm:col-span-2">Message (optional)<textarea name="message" rows="4" class={field}></textarea></label>
        </div>
        <p class="mt-3 text-[14px] leading-[1.5]">Please do not share medical details in this form. Tell us about them when we call.</p>
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute left-[-9999px]" />
        <label class="mt-5 flex items-start gap-3 text-[15px] leading-[1.5]">
          <input type="checkbox" name="consent" required class="mt-1 h-5 w-5 shrink-0 accent-[#2f4373]" />
          <span>I agree that Marano Eye Care may contact me by phone or email about this request. I have read the <a class="underline" href="/your-privacy">Privacy Policy</a>. *</span>
        </label>
        <p id="appt-msg" role="status" aria-live="polite" class="mt-5 hidden rounded-[12px] px-4 py-3 text-[16px]"></p>
        <p class="mt-6"><button type="submit" class="btn">Request Appointment</button></p>
      </form>

      <aside class="grid gap-5">
        <div class="rounded-[16px] bg-navy p-8 text-white">
          <h2 class="serif text-[26px] leading-tight">Prefer to call?</h2>
          <p class="mt-2 text-white/85">Choose the office closest to you.</p>
          <ul class="mt-5 grid gap-4">
            {site.locations.map((l) => (
              <li class="border-t border-white/20 pt-4">
                <p class="serif text-[22px]">{l.city}, NJ</p>
                <p class="text-[15px] text-white/80">{l.address[0]}</p>
                <p class="text-[14px] text-white/70">{hours[l.city]}</p>
                <a href={l.phoneHref} class="mt-1 inline-block text-[18px] font-semibold text-[#a9bff0] hover:underline">{l.phone}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-[16px] bg-mist p-8">
          <h2 class="serif text-[22px] text-navy">Eye emergency?</h2>
          <p class="mt-2 text-[16px] leading-[1.6]">Sudden vision loss, flashes of light, a dark curtain or severe eye pain need care right away. Call <a class="font-semibold text-navy underline" href="tel:+19733220100">973-322-0100</a>. If you cannot reach us, go to the nearest emergency room.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('appt') as HTMLFormElement | null;
  if (form) {
    const msg = document.getElementById('appt-msg')!;
    const q = new URLSearchParams(location.search);
    const pre = (name: string, v: string | null) => { const el = form.elements.namedItem(name) as HTMLSelectElement | null; if (el && v) el.value = v; };
    pre('office', q.get('office')); pre('service', q.get('service'));
    const show = (text: string, ok: boolean) => {
      msg.textContent = text; msg.classList.remove('hidden', 'bg-[#e4f4ea]', 'text-[#16543a]', 'bg-[#fbe9e7]', 'text-[#8a2a1c]');
      msg.classList.add(...(ok ? ['bg-[#e4f4ea]', 'text-[#16543a]'] : ['bg-[#fbe9e7]', 'text-[#8a2a1c]']));
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const data = Object.fromEntries(new FormData(form).entries());
      if (data.company) return; // spam trap
      const endpoint = form.dataset.endpoint;
      const office = String(data.office || '');
      if (!endpoint) {
        show(`Online requests are not switched on yet. Please call our ${office || 'nearest'} office to book. Thank you!`, false);
        return;
      }
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement; btn.disabled = true;
      try {
        const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) });
        if (!r.ok) throw new Error('bad');
        form.reset(); show('Thank you! We received your request. Our team will call you soon to confirm.', true);
      } catch { show('Sorry, something went wrong. Please call our office to book.', false); }
      btn.disabled = false;
    });
  }
</script>
