---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import CtaSub from '../components/home/CtaSub.astro';
import { site } from '../data/site';
import { home } from '../data/home';
import { img } from '../data/assets';
import { reviews, rating } from '../data/reviews';
import { services } from '../data/svc';

const tags = ['All', ...new Set(reviews.map((r) => r.tag))];
const stars = Array.from({ length: 5 });
const star = '<path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9z"/>';
const feature = reviews[0];
const rest = reviews.slice(1);
---
<BaseLayout title="Patient Testimonials | Marano Eye Care" description="Read what patients say about Marano Eye Care in Denville, Livingston and Newark, NJ. Real reviews and patient video stories.">
  <PageHero
    title="Patient Testimonials"
    lede="Real words from the people we care for. Thank you for trusting us with your eyes."
    image={services.find((s) => s.slug === 'comprehensive-eye-exam')!.photos[2]}
    imageAlt="A smiling patient after an eye exam"
    crumbs={[{ label: 'Testimonials' }]}
  />

  <!-- Rating summary -->
  <section class="bg-white pb-[clamp(24px,4vw,48px)] pt-[clamp(32px,5vw,64px)]">
    <div class="row-wrap">
      <div class="grid items-center gap-6 rounded-[16px] bg-mist p-8 md:grid-cols-[auto_1fr_auto] md:gap-12 md:p-10">
        <div class="text-center md:text-left">
          <p class="serif text-[clamp(56px,7vw,84px)] leading-none text-navy">{rating.score}<span class="text-[0.4em] text-steel"> / 5</span></p>
          <p class="mt-2 flex justify-center gap-1 text-[#e0a82e] md:justify-start" aria-label="Rated 4.83 out of 5">
            {stars.map(() => <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={star}></svg>)}
          </p>
        </div>
        <p class="text-center text-[19px] leading-[1.6] text-navy md:text-left">Rated <strong>{rating.score} out of 5</strong> from <strong>{rating.count} patient reviews</strong>. People tell us we are thorough, kind and easy to talk to.</p>
        <p class="text-center"><a href={site.bookingUrl} class="btn">Book a Visit</a></p>
      </div>
    </div>
  </section>

  <!-- Featured quote -->
  <section class="bg-white py-[clamp(32px,5vw,72px)]">
    <div class="row-wrap">
      <figure class="mx-auto max-w-[900px] text-center">
        <svg width="44" height="34" viewBox="0 0 44 34" class="mx-auto text-sky" aria-hidden="true"><path fill="currentColor" d="M0 34V20C0 9 6 2 17 0l2 5C13 7 10 11 10 16h9v18H0zm25 0V20C25 9 31 2 42 0l2 5c-6 2-9 6-9 11h9v18H25z"/></svg>
        <blockquote class="serif mt-5 text-[clamp(26px,3.4vw,44px)] leading-[1.25] text-navy">{feature.text}</blockquote>
        <figcaption class="mt-5 text-[17px] text-steel">{feature.name}, patient</figcaption>
      </figure>
    </div>
  </section>

  <!-- Review grid with filter -->
  <section class="bg-card py-[clamp(48px,7vw,110px)]">
    <div class="row-wrap">
      <div class="mx-auto max-w-[760px] text-center">
        <span class="eyebrow">Reviews</span>
        <h2 class="serif text-[length:var(--fs-h2)] leading-[1.15] text-navy">What our patients <i class="block">are saying</i></h2>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-2" role="group" aria-label="Filter reviews">
        {tags.map((t, i) => (
          <button type="button" data-filter={t} aria-pressed={i === 0 ? 'true' : 'false'} class="filter-chip rounded-full border border-navy/30 bg-white px-4 py-2 text-[15px] text-navy transition hover:border-navy aria-pressed:bg-navy aria-pressed:text-white">{t}</button>
        ))}
      </div>
      <ul class="mt-10 columns-1 gap-6 sm:columns-2 lg:columns-3" id="review-list">
        {rest.map((r) => (
          <li data-tag={r.tag} class="mb-6 break-inside-avoid">
            <figure class="hover-card on-white rounded-[16px] border border-transparent bg-white p-7">
              <p class="flex gap-0.5 text-[#e0a82e]" aria-label="5 out of 5 stars">
                {stars.map(() => <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={star}></svg>)}
              </p>
              <blockquote class="mt-4 text-[18px] leading-[1.6] text-navy">{r.text}</blockquote>
              <figcaption class="mt-5 flex items-center gap-3 text-[15px]">
                <span class="grid h-9 w-9 place-items-center rounded-full bg-mist text-[14px] font-semibold text-steel">{r.name[0]}</span>
                <span><span class="block font-semibold text-navy">{r.name}</span><span class="text-steel">{r.tag}</span></span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-center text-[14px]">A selection of five-star reviews, shown as patients wrote them.</p>
    </div>
  </section>

  <!-- Kind words strip -->
  <section class="bg-navy py-[clamp(48px,7vw,100px)] text-white">
    <div class="row-wrap">
      <h2 class="serif text-center text-[length:var(--fs-h2b)] leading-[1.2]">More <i>kind words</i></h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {home.quotes.map((q) => (
          <li class="hover-card on-dark rounded-[16px] border border-transparent bg-white/10 p-7 serif text-[22px] leading-[1.4]">{q}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Video stories -->
  <section class="bg-white py-[clamp(48px,7vw,110px)]">
    <div class="row-wrap">
      <div class="mx-auto max-w-[760px] text-center">
        <span class="eyebrow">Patient stories</span>
        <h2 class="serif text-[length:var(--fs-h2)] leading-[1.15] text-navy">Watch their <i class="block">own words</i></h2>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-3 min-[801px]:grid-cols-2 min-[1025px]:grid-cols-5">
        {home.patients.map((p, i) => (
          <div class="patient-tile">
            <img src={img.patients[i]} alt={`${p.name}, patient video`} loading="lazy" />
            <div class="content"><h3 class="serif">{p.name}</h3><p>{p.topic}</p></div>
            <a href={p.url} class="popup-video" aria-label={`Watch ${p.name}'s story`}></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaSub />
</BaseLayout>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter-chip')];
  const items = [...document.querySelectorAll<HTMLElement>('#review-list [data-tag]')];
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    const f = c.dataset.filter;
    items.forEach((li) => { li.hidden = !(f === 'All' || li.dataset.tag === f); });
  }));
</script>
